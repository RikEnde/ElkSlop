.gradle/
.kotlin/
.tools/
.claude/
**/build/
.idea/
*.iml
.DS_Store
# Track only the two ROMs the emulator needs; other images (backups,
# alternative dumps) stay local.
roms/*
!roms/os.rom
!roms/basic.rom
tapes/*
!tapes/intro-english.uef
!tapes/intro-german.uef
!tapes/peeko-english.uef
!tapes/README.md

# Third-party ROM source reconstructions: no licence, so kept locally for
# reference and never published. Only our README about them is tracked.
docs/rom-sources/*
!docs/rom-sources/README.md
!docs/rom-sources/fetch.sh

# Your own programs and the tapes built from them stay local. Only the
# examples and the README are tracked; programs/build/ is ignored above.
programs/*
!programs/README.md
!programs/hello.bas
!programs/greeting.asm
